# Backend .gitignore
# Node dependencies
node_modules/
# Build output
dist/
# TypeScript build info
*.tsbuildinfo
# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
# Environment variables
.env
.env.*
# Coverage reports
coverage/
.nyc_output/
# OS generated files
.DS_Store
Thumbs.db
# IDE/editor configs
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# Temporary files
.temp/
.tmp/
.vercel/
# Runtime data
pids
*.pid
*.seed
*.pid.lock
report.*.json
