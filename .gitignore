# ==========================================
# Comprehensive GitIgnore for Fullstack App
# (Covers root, frontend, and backend)
# ==========================================

# Dependencies (Node / Yarn / pnpm)
node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compiled & Build Outputs
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# OS / System Files
.DS_Store
Thumbs.db
*.pem

# IDEs & Code Editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Temporary files & Vercel
.temp/
.tmp/
.vercel/

# Runtime data
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
report.*.json
